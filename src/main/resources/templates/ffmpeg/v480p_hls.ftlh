-y \
-init_hw_device qsv=hw -filter_hw_device hw \
-map 0:v:0 -map 0:a:0 \
-c:v ${videoEncoder} -preset veryfast \
-vf "scale=848:480:force_original_aspect_ratio=decrease,pad=848:480:(ow-iw)/2:(oh-ih)/2,setsar=1,format=nv12,hwupload=extra_hw_frames=64" \
-b:v 1200k -maxrate 1284k -bufsize 1800k -g 180 -keyint_min 180 \
-c:a ${audioEncoder} -b:a 128k -ac 2 \
-sc_threshold 0 \
-f hls -hls_time 6 -hls_playlist_type vod -hls_list_size 0 \
-hls_flags independent_segments \
-hls_segment_filename "v480p/segment_%03d.ts"