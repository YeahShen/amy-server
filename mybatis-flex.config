# MyBatis-Flex APT 处理器配置（放在项目根目录才会被读取，处理器从 target/classes 逐级向上查找）
# 说明：处理器强校验未知键——写错键名会直接抛异常中断编译
# 是否启用 APT
processor.enable=true
# 配置文件与生成源码的字符编码
processor.charset=UTF-8
# 生成 TableDef 的包：留空 = 实体所在包 + .table
processor.tableDef.package=
# 生成 TableDef 的类名后缀，实体 AppUser -> AppUserTableDef
processor.tableDef.classSuffix=TableDef
# 生成 TableDef 中静态属性名风格，upperCase = 常量名（APP_USER / USERNAME）
processor.tableDef.propertiesNameStyle=upperCase
# 是否额外生成聚合 Tables 类（含全部表定义）
processor.allInTables.enable=false
processor.allInTables.className=Tables
# 是否生成 Mapper 接口（实体无手写 Mapper 时按此开关生成）
processor.mapper.generateEnable=true
# 生成 Mapper 的包：留空 = 实体所在包
processor.mapper.package=site.ashenstation.infrastructure.dao
# 是否在生成的 Mapper 类上添加 @Mapper 注解
processor.mapper.annotation=true
# 生成 Mapper 的父接口
processor.mapper.baseClass=com.mybatisflex.core.BaseMapper
